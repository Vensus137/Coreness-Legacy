{
  "name": "coreness-flow-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Automation Platform",
  "author": "Vensus137",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:29774 && electron . --dev\"",
    "electron:build": "npm run build && node scripts/copy-vite-for-electron.cjs && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.coreness.flow",
    "productName": "Coreness Flow",
    "executableName": "CorenessFlow",
    "directories": {
      "output": "../build/electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/backend",
        "to": "backend"
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../plugins",
        "to": "plugins"
      },
      {
        "from": "../models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "../LICENSE",
      "include": "nsis/plugins-clean.nsh"
    }
  }
}
